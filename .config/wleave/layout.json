{
    "buttons": [
        {
            "label": "logout",
            "action": "hyprshutdown",
            "text": "Log Out",
            "keybind": "l",
            "icon": "/usr/share/wleave/icons/logout.svg"
        },
        {
            "label": "shutdown",
            "action": "hyprshutdown -p \"systemctl poweroff\"",
            "text": "Shutdown",
            "keybind": "s",
            "icon": "/usr/share/wleave/icons/shutdown.svg"
        },
        {
            "label": "suspend",
            "action": "systemctl suspend",
            "text": "Suspend",
            "keybind": "u",
            "icon": "/usr/share/wleave/icons/suspend.svg"
        },
        {
            "label": "reboot",
            "action": "hyprshutdown -p \"systemctl reboot\"",
            "text": "Reboot",
            "keybind": "r",
            "icon": "/usr/share/wleave/icons/reboot.svg"
        }
    ]
}
